{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mnr-network",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "triggers": { "crons": ["* * * * *", "*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mnr-status",
      "database_id": "8ec8ac8b-7b8f-41d5-baf8-b1f208835cdd",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "mnr.network", "custom_domain": true },
    { "pattern": "www.mnr.network", "custom_domain": true }
  ]
}
